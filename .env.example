# Polymarket 15-Min Crypto Arbitrage Tool

## Environment Variables

# 服务器配置
HOST=0.0.0.0
PORT=8090

# 数据库路径
DB_PATH=data/trades.db
BOT_DB_PATH=data/bot.db

# Telegram Bot Token (可选)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# 交易模式配置
# TRADING_MODE: simulation (默认模拟) / real (真实交易)
TRADING_MODE=simulation

# 下单类型配置 (真实交易时生效)
# ORDER_TYPE: FOK (全部成交或取消) / FAK (部分成交) / GTC (限价挂单)
ORDER_TYPE=GTC

# Polymarket 钱包私钥 (真实交易时必填)
# 从 Polymarket 网站 -> Settings -> Export Private Key 获取
# POLYMARKET_PRIVATE_KEY=0x...

# 代理钱包地址 (通过 Google 等社交账号注册的用户必填!)
# 获取方法: 登录 Polymarket 网站 -> 右上角头像 -> Settings -> 复制 "Wallet Address"
# 注意: 这个地址与私钥派生的 EOA 地址不同!
# PROXY_WALLET_ADDRESS=0x...

# 策略配置
CONFIG_FILE=strategy_config.yaml
# 扫描间隔 (秒)
SCAN_INTERVAL=5

