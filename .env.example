# Polymarket 15-Min Crypto Arbitrage Tool

## Environment Variables

# 服务器配置
HOST=0.0.0.0
PORT=8090

# 数据库路径
DB_PATH=data/trades.db
BOT_DB_PATH=data/bot.db

# Telegram Bot Token (可选)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# 交易模式配置
# TRADING_MODE: simulation (默认模拟) / real (真实交易)
TRADING_MODE=simulation

# 下单类型配置 (真实交易时生效)
# ORDER_TYPE: market (市价FOK,taker费用) / limit (限价GTC,maker零费用)
ORDER_TYPE=limit

# Polymarket 钱包私钥 (真实交易时必填)
# POLYMARKET_PRIVATE_KEY=0x...

# 策略配置
CONFIG_FILE=strategy_config.yaml
