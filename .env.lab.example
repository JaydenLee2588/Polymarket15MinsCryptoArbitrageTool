# =============================================================================
# M0 Day 0 PoC 实验配置模板 — Refs #3
#
# 这是脱敏模板，只含占位符。复制为 .env.lab 后使用：
#   cp .env.lab.example .env.lab
# .env.lab 已被 .gitignore / .dockerignore 排除，不会进入 Git 或镜像。
#
# 本阶段原则：不配置任何钱包私钥、不配置任何交易凭证。
# 字段清单来自源码核查（见 reports/engineering/poc/day0-docker-smoke.md §8）。
# 不要从 .env.example 复制任何值 —— 那个文件里的 BUILDER_* 是原作者的真实凭证。
# =============================================================================

# --- 服务 (main.go:156-158) ---
# HOST 默认 0.0.0.0。容器内保持 0.0.0.0，靠 docker -p 127.0.0.1:8090:8090 限制暴露面。
HOST=0.0.0.0
PORT=8090

# --- SQLite (main.go:78, main.go:104) ---
# 目录由 internal/database.InitDB 自动创建 (MkdirAll 0755)
DB_PATH=/app/data/trades.db
BOT_DB_PATH=/app/data/bot.db

# --- 交易安全边界：本阶段必须保持如下取值 ---
# TradingMode 只从环境变量读取，YAML 里的值不生效
#   (api/config_loader.go:286, api/pattern_config_loader.go:128)
# 空值等价于 simulation；"real" 才会进入真实下单路径
TRADING_MODE=simulation
# api/strategy.go:98 —— 必须显式 false
ENABLE_MAIN_STRATEGY=false
# main.go:181 默认值是 "true"，必须显式 false
ENABLE_PATTERN_STRATEGY=false
# api/pattern_config_loader.go:181
SNIPER_MODE=false

# --- 策略配置文件：本阶段留空 ---
# 留空时代码回退到 strategy_config.yaml / strategy_config_3.yaml，
# 这两个文件在仓库中并不存在，因此策略加载会被跳过。
# 不要在本阶段指向 *_real.yaml。
CONFIG_FILE=
PATTERN_CONFIG_FILE=

# --- 以下字段本阶段一律留空（留空即不启用对应功能） ---
# 留空 -> main.go:112 打印"跳过 Telegram Bot"
TELEGRAM_BOT_TOKEN=
# 留空 -> 仅在 TRADING_MODE=real 时才会被要求 (api/strategy.go:123)
POLYMARKET_PRIVATE_KEY=
PROXY_WALLET_ADDRESS=
MAKER_ADDRESS=
# Polymarket CLOB 手动 API 凭证 (api/strategy.go:150-153)
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
POLY_EOA_ADDRESS=
# Builder / 赎回服务凭证 (api/strategy.go:208-210)
# 留空 -> 打印"Builder API 凭证未配置 (自动赎回将不可用)"，这是本阶段期望状态
BUILDER_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=
# 链上 RPC，仅在 real 模式初始化赎回服务时使用 (api/strategy.go:202)
POLYGON_RPC_URL=
# src/redeem.go:711，仅赎回路径使用
TX_WAIT_TIMEOUT_SECONDS=

# --- .env.example 中存在但代码从未读取的字段（死配置，仅记录） ---
# BUILDER_ADDRESS
# SCAN_INTERVAL
